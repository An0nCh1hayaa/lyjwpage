{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "lyjwpage 运行时架构",
    "locale": "zh-CN",
    "output": "docs/architecture.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "ingest",
        "label": "上报入库",
        "focus": [
          "vps",
          "psn_reporter",
          "device_hubs",
          "lan_reporters",
          "ingest",
          "edgeone"
        ],
        "note": "各上报侧只跟一个源说话，POST 到 /api/ingest/<来源>。Vercel 那份由 ingest Worker 接，EdgeOne 那份暂由站点自己接。"
      },
      {
        "id": "relay",
        "label": "两份生产互转",
        "focus": [
          "ingest",
          "edgeone",
          "redis_vercel",
          "redis_edgeone",
          "vercel"
        ],
        "note": "收到上报的那份原样转给对端；Worker 写 Vercel 的 Redis 后回敲 lyjw.me/api/revalidate，EdgeOne 写自己的 Redis、刷自己的 tag。"
      },
      {
        "id": "push",
        "label": "浏览器三条腿",
        "focus": [
          "vercel",
          "edgeone",
          "ingest",
          "live_push_cn",
          "browser"
        ],
        "note": "SSR 首屏、SWR 轮询 /api/status/*、Worker 房间的 WebSocket 推送。"
      },
      {
        "id": "counter",
        "label": "在线人数反馈环",
        "focus": [
          "browser",
          "online_counter",
          "psn_reporter"
        ],
        "note": "浏览器连上就是一个人头，PlayStation 上报 Worker 读 /count 在三档之间切换。"
      },
      {
        "id": "assets",
        "label": "图片直传 R2",
        "focus": [
          "device_hubs",
          "lan_reporters",
          "r2"
        ],
        "note": "上报侧把图片字节直传 R2，站点只收 objectKey，从不经手图片本身。"
      }
    ],
