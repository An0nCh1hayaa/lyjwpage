# 复制成 .env.local 再填。除 NEXT_PUBLIC_ 开头的那几项外，都只在服务端读取。

# ── 最近在看：Emby ──────────────────────────────────────────
# 本站不向 Emby 发任何请求，数据由 NAS 上的推送代理送进来。
# 取数用的 EMBY_URL / EMBY_API_KEY / EMBY_USER_ID 只配在那边，见
# reporters/emby-reporter/README.md
#
# 站点这边只需要一个地址：「在 Emby 里打开」的跳转链接，必须是浏览器能访问到的。
# 不填就不给链接（没有内网地址可退，退了也是个点不开的链接）
EMBY_PUBLIC_URL=https://emby.example.com

# ── 图片存储：Cloudflare R2（S3 协议）───────────────────────
# 推进来的图（Emby 海报、Mac 应用图标、自建歌单封面）压缩后按内容哈希写入
# R2，状态里只存公开 URL，浏览器直连 R2 取图 —— 本站没有图片读路径，
# Redis 里也不放任何图片二进制。
# 下面五项缺任何一项则图片存储整体停用（状态照常流转，只是没有图）。
#
# S3 API 端点，在 Cloudflare 控制台「R2 → 概览」能看到 account id
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
# R2 API 令牌，权限给「对象读写」、按桶授权即可
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 浏览器取图的完整地址前缀。Vercel 可填 R2 自定义域，EdgeOne 可填以 R2 为
# 源站的 COS CDN；Redis 只存 objectKey，响应时按当前部署的这个值拼地址。
# 上面那个 S3 端点不能公开读，填它等于发一堆 401 出去。
R2_PUBLIC_BASE_URL=https://img.example.com

# ── 最近在听：Apple Music ───────────────────────────────────
# 站点这侧一个凭据都不配。签名用的 .p8 私钥留在 Mac 的钥匙串里由系统保管，
# 上报器用 MusicKit 现签 developer token、连同同一次授权拿到的 music user
# token 一起塞进 /api/ingest/mac 的信封，站点收下存 Redis（到期前由上报器重签
# 重发）。见 src/lib/apple-music-credentials.ts。
#
# 目录搜索与店面地区（ISO 3166-1 alpha-2 小写代码，如 cn、us、jp）。不配默认 cn。
# 查跳转链接和拉「最近在听」（自建歌单封面要按店面查一次）读的是同一个值
APPLE_MUSIC_STOREFRONT=cn

# ── 图片优化：本机走 fake-IP 代理时才用 ─────────────────────
# 只影响 next/image 去取自建歌单封面（*.blobstore.apple.com）这一路。
# Clash/Surge 那类代理在 TUN 模式下把域名解析到 198.18.0.0/15，Next 的 SSRF
# 防护看到私有 IP 就拒绝取图。默认关，Vercel 上不要设 —— 那边解析得到真实公网
# IP，开了纯属白白削弱防护。详见 next.config.ts 里那段注释。
IMAGE_ALLOW_LOCAL_IP=false

# Apple 自建歌单封面是带 AWS SigV4 查询参数的预签名 URL。Vercel 的 Next 图片
# 优化器会原样回源，可以保持默认；EdgeOne 的适配器会向源 URL 追加 imageMogr2
# 参数，破坏签名，所以 EdgeOne 部署设为 false，让浏览器直接读取原始地址。
# NEXT_PUBLIC_ 变量在构建期写入浏览器产物，修改后必须重新部署。
NEXT_PUBLIC_SIGNED_IMAGE_OPTIMIZATION=true

# ── 充电头：a2687-telemetry ─────────────────────────────────
# 本站不轮询充电头。Mac 上报器读本机 a2687 的 /status，作为 charger 模块塞进
# /api/ingest/mac 的信封 —— 站点这侧只有下面这一个参数。
#
# 上报间隔，用来判断断流（取「3 倍间隔」「90 秒」「心跳窗口」三者里最大的一个：
# 安静时段续这条时间戳的是纯心跳，窗口短于心跳会让卡片闪回未连接，见 lib/anker）
CHARGER_PUSH_INTERVAL_MS=30000

# ── Mac 上报器存活 ─────────────────────────────────────────
# 心跳 90 秒一次。超过这个窗口没消息就判掉线（默认 300 秒 ≈ 三倍间隔）。
# 优雅离开（退出 / 睡眠）走 declaredOffline，不等这个窗口，所以放宽窗口只推迟
# 「崩溃 / 断网 / 强制关机」的判定，日常体验不变。
#
# ⚠️ 放宽窗口和上报器降频的顺序不能反：先改这里（两份生产都要），再改
# MacTelemetryHub 的心跳间隔。反过来做会有一段时间全站断续显示离线。
HEARTBEAT_WINDOW_MS=300000

# ── 各 agent 的限额：容器上报器 ────────────────────────────
# Claude Code / Codex / Grok Build 这些的套餐和用量窗口不再随 Mac 走，由 NAS 上的
# reporters/agent-limits-reporter 走 /api/ingest/agents 推，每轮必发（那一封就是心跳）。
# 限额三档 5 / 10 / 60 分钟，陈旧窗口为三轮最慢档加余量（185 分钟）。先部署两份站点，再给上报器降频。
AGENT_LIMITS_STALE_MS=11100000

# ── Redis ──────────────────────────────────────────────────
# 所有缓存（状态、图片、充电头历史）都存这里，进程重启和多实例都能共享。
# 不填则全部退回进程内存，本地开发照常可用 —— 但 serverless 上这不是可选项：
# 那边每个函数实例都是新的、随时被回收，退回进程内存等于每次请求看到的状态
# 都可能是空的。托管 Redis 走 rediss:// 即可，ioredis 自己认。
#
# **每一份生产部署填自己的那个 Redis**，就近选，不共用一份。两边的数据由上报
# 传播保持一致（见下面的 INGEST_PEERS）：收到上报的那份会把同一个请求原样转给
# 对面，对面写自己这份 Redis。从前两边共用一份，于是国内那份的每一次读写都要
# 跨一次海，而缓存失效还得再单独传播一遍。
#
# Preview 要么不配、要么用独立实例；只换 REDIS_PREFIX 只能隔离键，隔离不了
# 同一 Redis 套餐的并发连接额度，频繁预览会和生产一起把连接数顶满。
REDIS_URL=redis://127.0.0.1:6379
# 键名前缀，和同一个 Redis 里的其它东西区分开
REDIS_PREFIX=lyjwpage

# ── 实时推送：自建 Cloudflare Worker ───────────────────────
# 浏览器直连这个 Worker 收推送 —— 本站不持有任何长连接。不配则整体停用（页面退回
# 30 秒轮询，本地开发可以这样）。
#
# Vercel 那份填 workers/ingest 的源：它同时是上报入口和推送房间，上报器写进去的
# 状态由它直接广播。站点自己还会往这里 POST /publish 的只剩「最近在听」那份自拉的
# 列表。EdgeOne 那份暂时仍填它自己的 live-push。这里只填源，两条路径（浏览器连的
# /ws、服务端发的 /publish）由站点自己拼 —— 它们和事件名一样是站点和自己那个 Worker
# 之间的约定，拆成两个变量只会多一处能对不上的地方。
#
# **每一份生产部署填自己的那个房间**，和上面的 Redis、下面的 R2 交付域同一个道理：
# 上报会被转给对端，对端自己也要推一次给连着它那份页面的浏览器。两边填成同一个的话，
# 同一次变化会被广播两遍，每个浏览器收到两份一样的事件。
NEXT_PUBLIC_LIVE_PUSH_URL=https://ingest.example.com
# 发布密钥，和 Worker 上 `wrangler secret put LIVE_PUSH_SECRET` 存的那份一致。
# 上面那行会被编译进浏览器产物（地址本来就是公开的，谁都能连上收这份公开广播），
# 但这一行绝不能加 NEXT_PUBLIC_ 前缀 —— 加了等于把发布权限公开发布出去。
LIVE_PUSH_SECRET=

# ── 上报传播：对端部署 ─────────────────────────────────────
# 同一个仓库部署了两份生产（Vercel 一份、EdgeOne 一份），各有各的 Redis、各有各
# 的推送房间、各有各的 Next 缓存，而上报器只跟其中一个源说话。所以收到上报的那份
# 除了自己落库，还会把同一个请求原样转给对面（逗号分隔可填多个），对面进的是同一条
# 路径、同一个 handler，于是它写自己的 Redis、推自己的房间、刷自己的缓存。
#
# Vercel 那份**留空**：它不再接上报，写路径在 workers/ingest 上，转发也由那个 Worker
# 做（它的 wrangler.toml 里填 https://lyjw131.com）。EdgeOne 那份填 Worker 的源，
# 让它收到的上报也到 Vercel 这份 Redis。
#
# 转发出去的请求带 x-ingest-relay，对端见到它就不再往下传 —— 两边互填对方，
# 再传一次就成环了。鉴权仍用下面那把 TELEMETRY_INGEST_SECRET，站点和 Worker 填同一个。
#
# 留空则不传播，本地 dev 和 Preview 也因此不会去敲线上。
INGEST_PEERS=

# ── 状态端点的缓存 ─────────────────────────────────────────
# /api/status/* 默认把快照冻在 Next 的 `'use cache'` 里，上报按 tag 失效。
# 填 false 的部署上这层整个不进，每次请求直读 Redis。
#
# 给 EdgeOne 那份用：`revalidateTag` 只失效**本实例**那份缓存（Next 默认是每个进程
# 各自的内存 LRU，Vercel 另接了一套共享存储，所以在那边看起来是全局的）。EdgeOne
# 跑的是原样的 Next（腾讯云 SCF，多实例），收到上报的实例失效了自己那份，服务 GET
# 的实例不知情，只能等 10 分钟兜底 —— 2026-08-16 两边并排量过（当时 revalidate
# 还是 60 秒），落后 12~45 秒。国内那份的 Redis 就在同一朵云上，多打几次不心疼，
# 所以那边填 false，Vercel 那份保持默认。
#
# 只管状态端点：首屏那份得冻着才能预渲染，关掉之后第一帧仍可能旧到 10 分钟，
# 挂载后 SWR 打这些端点就是最新的。
STATUS_CACHE=true

# ── 推送鉴权 ───────────────────────────────────────────────
# 所有 /api/ingest/* 共用这一个密钥（Mac 上报器、Home Assistant、Emby 推送代理、
# iPhone 上的活动圆环上报器、VPS 上的 server-reporter），站点和 workers/ingest 填同一个。
# 站点这侧还用它验 Worker 回敲的 POST /api/revalidate —— 那个端点没配密钥一律 503。
# 上报入口不填则不校验，只在本地开发时可以这样。
#
# 它只是一把「收数据」的锁：站点没有任何端点会把 Apple Music 凭据发出去。从前
# GET /api/ingest/apple-music 会把它交给拉列表的上报器，那时拿到这个密钥就等于
# 拿到我的收听记录；拉列表收回站点之后那条路和那份敏感度一起没了。
TELEMETRY_INGEST_SECRET=

# Emby 的播放通知发给 NAS 上的代理、再由它带着上面这个密钥转发过来，
# 不直发本站 —— Emby 的 webhook 配置项加不了自定义请求头。
# 怎么配见 reporters/emby-reporter/README.md

# ── 在线人数统计：Cloudflare Workers (Durable Objects) ──────
# 同上，只填 Worker 的源。浏览器连的 /ws 由站点自己拼（那个 Worker 还开着
# /count，配成带路径的完整地址就只够表达其中一条）。不填则不启用在线人数长连接。
NEXT_PUBLIC_ONLINE_COUNTER_URL=https://online.example.com

# ── 跟着一起听：Cloudflare Worker ──────────────────────────
# 访客用自己的 Apple Music 订阅跟着听时，要一份短时效的 MusicKit developer
# token，由 workers/musickit-token 现签，填它部署后的地址（同上，只填源）。
#
# 私钥和允许的域名都配在那个 Worker 上，不在这里：.p8 走 wrangler secret，
# 域名走它的 ALLOWED_ORIGINS —— 那份名单既是访问闸门，也会被签进 JWT 的
# origin 声明由 Apple 校验。详见 workers/musickit-token/README.md。
#
# 不填则「一起听」整体停用，卡片右上角照旧显示「Apple Music」。
NEXT_PUBLIC_MUSICKIT_TOKEN_URL=https://musickit.example.com

# ── GitHub 贡献热力图 ─────────────────────────────────────
# GraphQL 拉 LYJW131 的 contributionCalendar。不填则联系卡片不画这张图。
#
# Fine-grained 个人 token 进不了组织仓，格子会比资料页少一截。要用 classic PAT
#（ghp_），scope 能看见那些组织项目。两份生产各配一份。
GITHUB_TOKEN=

# ── 页脚附加行 ─────────────────────────────────────────────
# 主行下面再挂一行文案。不配 TEXT 就不渲染。HREF 选填，有则整行可点。
# 拆成两项是因为 EdgeOne 变量值不能有空格，塞一段 HTML 填不进去。
FOOTER_EXTRA_TEXT=附加说明
FOOTER_EXTRA_HREF=https://example.com/

# Vercel 的 NEXT_PUBLIC_LIVE_PUSH_URL 同时是 /api/ingest/* 的路由层转交目标。
# Production 使用 ingest Worker 的源；EdgeOne 沿用自己的 live-push 源，不生成此 rewrite。
