# 上报 Worker 的源，上报器自动拼 /api/ingest/server；定节奏的人头数也从它拼 /count。
# SITE_INGEST_URL 可覆盖上报端点；本地联调可填写本地 ingest Worker 地址。
SITE_URL=https://ingest.homepage.lyjw.llc
# SITE_INGEST_URL=

# 和站点同名变量对上，作 Bearer 鉴权。站点没配时才可留空。
TELEMETRY_INGEST_SECRET=

# 节点名。落地城市优先用查 IP 得到的 city，查不到才用 HOST_LOCATION。
HOST_ID=misaka-jp
HOST_LOCATION=Tokyo

# 三档间隔：有页面可见 / 只是开着 / 一个都没开。站点那侧的断流窗口
# SERVER_STALE_MS（50 分钟）锚的是最慢那档，改 IDLE_INTERVAL_MS 要先放宽那边 ——
# 顺序不能反：站点先部署放宽的窗口再改这里，否则中间那段时间卡片会断续显示离线。
LIVE_INTERVAL_MS=60000
OPEN_INTERVAL_MS=120000
IDLE_INTERVAL_MS=900000
COUNT_TIMEOUT_MS=2500
PUSH_TIMEOUT_MS=10000
