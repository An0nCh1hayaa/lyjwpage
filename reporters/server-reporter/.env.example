# 上报 Worker 的源，上报器自动拼 /api/ingest/server。
# SITE_INGEST_URL 可覆盖为完整端点；本地联调可填写本地 ingest Worker 地址。
SITE_URL=https://ingest.homepage.lyjw.llc
# SITE_INGEST_URL=

# 和站点同名变量对上，作 Bearer 鉴权。站点没配时才可留空。
TELEMETRY_INGEST_SECRET=

# 节点名。落地城市优先用查 IP 得到的 city，查不到才用 HOST_LOCATION。
HOST_ID=misaka-jp
HOST_LOCATION=Tokyo

# 采集和上报的间隔。站点那侧的断流窗口默认 90 秒（三倍），这边改长了
# 那边的 SERVER_STALE_MS 要跟着放宽 —— 而且顺序不能反：站点先部署放宽的窗口，
# 再改这里，否则中间那段时间每一轮都踩在窗口边上，卡片会断续显示离线。
INTERVAL_MS=30000
PUSH_TIMEOUT_MS=10000
